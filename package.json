{
  "name": "replas-g",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0",
    "pnpm": ">=10.0.0"
  },
  "pnpm": {
    "overrides": {
      "sharp": "^0.34.5"
    },
    "patchedDependencies": {
      "@capgo/camera-preview": "patches/@capgo__camera-preview.patch"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc --noEmit",
    "preview": "vite preview",
    "start": "vite",
    "lint": "biome check --write .",
    "format": "biome check --write --unsafe && biome format --write .",
    "check": "tsc --noEmit",
    "capgo:build:ios": "npx @capgo/cli@latest build request br.com.gecloud.replas --platform ios",
    "capgo:build:android": "npx @capgo/cli@latest build request br.com.gecloud.replas --platform android",
    "capgo:cred:save": "npx @capgo/cli@latest build credentials save",
    "assets:generate": "npx @capacitor/assets generate --iconBackgroundColor '#0f172a' --iconBackgroundColorDark '#0f172a' --splashBackgroundColor '#0f172a' --splashBackgroundColorDark '#0f172a' && mv -f icons/*.webp public/icons/ && rmdir icons && sed -i '' 's|\"src\": \"../icons/|\"src\": \"/icons/|g' public/manifest.json"
  },
  "dependencies": {
    "@capacitor/android": "^8",
    "@capacitor/camera": "^8.0.2",
    "@capacitor/cli": "^8",
    "@capacitor/core": "^8",
    "@capacitor/ios": "^8",
    "@capgo/camera-preview": "^8.1.4",
    "@gsap/react": "^2",
    "@hookform/resolvers": "^5",
    "@ionic/pwa-elements": "^3.4.0",
    "@radix-ui/react-accordion": "^1",
    "@radix-ui/react-alert-dialog": "^1",
    "@radix-ui/react-avatar": "^1",
    "@radix-ui/react-checkbox": "^1",
    "@radix-ui/react-collapsible": "^1",
    "@radix-ui/react-dialog": "^1",
    "@radix-ui/react-dropdown-menu": "^2",
    "@radix-ui/react-label": "^2",
    "@radix-ui/react-popover": "^1",
    "@radix-ui/react-progress": "^1",
    "@radix-ui/react-radio-group": "^1",
    "@radix-ui/react-scroll-area": "^1",
    "@radix-ui/react-select": "^2",
    "@radix-ui/react-separator": "^1",
    "@radix-ui/react-slot": "^1",
    "@radix-ui/react-switch": "^1",
    "@radix-ui/react-tabs": "^1",
    "@radix-ui/react-toggle": "^1",
    "@radix-ui/react-tooltip": "^1",
    "@radix-ui/react-use-controllable-state": "^1",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-devtools": "^0",
    "@tanstack/react-query": "^5",
    "@tanstack/react-router": "^1",
    "@tanstack/react-router-devtools": "^1",
    "@tanstack/react-table": "^8",
    "@tanstack/router-plugin": "^1",
    "class-variance-authority": "^0",
    "clsx": "^2",
    "cmdk": "^1",
    "date-fns": "^4",
    "framer-motion": "^12",
    "gsap": "^3",
    "jwt-decode": "^4",
    "lucide-react": "^0",
    "next-themes": "^0",
    "radix-ui": "^1",
    "react": "^19",
    "react-camera-pro": "^1.4.0",
    "react-day-picker": "^9",
    "react-dom": "^19",
    "react-hook-form": "^7",
    "react-qr-code": "^2.0.18",
    "react-webcam": "^7.2.0",
    "recharts": "2",
    "sharp": "^0",
    "sonner": "^2",
    "tailwind-merge": "^3",
    "tailwindcss": "^4",
    "vaul": "^1",
    "zod": "^3",
    "zustand": "^5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2",
    "@capacitor/assets": "^3",
    "@tanstack/devtools-vite": "^0",
    "@tanstack/eslint-plugin-query": "^5",
    "@testing-library/dom": "^10",
    "@testing-library/react": "^16",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5",
    "jsdom": "^27",
    "shadcn": "^3",
    "tsx": "^4",
    "tw-animate-css": "^1",
    "typescript": "^5",
    "vite": "^7",
    "vitest": "^3",
    "web-vitals": "^5"
  }
}
